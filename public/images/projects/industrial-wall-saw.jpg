  <line x1="540" y1="140" x2="260" y2="360" stroke="#5B6266" stroke-width="3"/>
  <text x="400" y="420" font-family="sans-serif" font-size="24" font-weight="bold" fill="#FFFFFF" text-anchor="middle" letter-spacing="2">INDUSTRIAL WALL SAW OPENING</text>
  <text x="400" y="455" font-family="sans-serif" font-size="14" fill="#E85D04" text-anchor="middle" letter-spacing="3">MOUNTAIN VIEW CONCRETE CUTTING</text>
