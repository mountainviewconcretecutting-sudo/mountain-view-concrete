<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <rect width="800" height="600" fill="#1E2022"/>
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#2A2D30" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="800" height="600" fill="url(#grid)"/>
  <circle cx="400" cy="270" r="90" fill="none" stroke="#E85D04" stroke-width="6" stroke-dasharray="12 6"/>
  <circle cx="400" cy="270" r="50" fill="none" stroke="#5B6266" stroke-width="4"/>
  <circle cx="400" cy="270" r="8" fill="#E85D04"/>
  <text x="400" y="420" font-family="sans-serif" font-size="24" font-weight="bold" fill="#FFFFFF" text-anchor="middle" letter-spacing="2">DOWNTOWN OFFICE CORE DRILLING</text>
  <text x="400" y="455" font-family="sans-serif" font-size="14" fill="#E85D04" text-anchor="middle" letter-spacing="3">MOUNTAIN VIEW CONCRETE CUTTING</text>
</svg>
